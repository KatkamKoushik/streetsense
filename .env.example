# ==============================================================================
# StreetSense Environment Configuration Template
# Copy this file to '.env' before starting the backend application.
# ==============================================================================

# Runtime Environment: 'development' | 'staging' | 'production' | 'test'
# CRITICAL: In 'staging' and 'production', the application strictly fails closed
# if insecure default secrets or keys shorter than 32 characters are supplied.
ENVIRONMENT=development

PROJECT_NAME="StreetSense Real-Time Sensing & Intelligent Alerting Platform"
VERSION=1.0.0
API_V1_PREFIX=/api/v1

# ------------------------------------------------------------------------------
# Database Configuration
# ------------------------------------------------------------------------------
# SQLite (Local Development Default):
DATABASE_URL=sqlite+aiosqlite:///./streetsense.db
# PostgreSQL (Production / Docker Compose):
# DATABASE_URL=postgresql+asyncpg://streetsense:replace_with_secure_db_password@localhost:5432/streetsense
DATABASE_ECHO=false

# ------------------------------------------------------------------------------
# Redis & Celery Background Queue
# ------------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ------------------------------------------------------------------------------
# Cryptographic Identity & JWT Secrets
# ------------------------------------------------------------------------------
# Generate with: openssl rand -hex 32
# MUST be at least 32 characters (256-bit entropy).
JWT_SECRET=streetsense_super_secret_jwt_key_for_dev_32char
JWT_ALGORITHM=HS256
JWT_ISSUER=streetsense:auth
JWT_AUDIENCE_DEVICE=streetsense:telemetry
JWT_AUDIENCE_CONSOLE=streetsense:console

ACCESS_TOKEN_EXPIRE_MINUTES=1440
CONSOLE_TOKEN_EXPIRE_MINUTES=480

# ------------------------------------------------------------------------------
# Provisioning & Administrative Access Keys
# ------------------------------------------------------------------------------
# Master secret required in 'X-Provisioning-Key' to enroll or revoke field devices
DEVICE_PROVISIONING_KEY=streetsense_dev_provisioning_master_key_32c

# Secret required in 'X-Console-Key' or body to issue console observation tokens
CONSOLE_API_KEY=streetsense_dev_console_access_key_32c

# ------------------------------------------------------------------------------
# Streaming Gateway Guardrails
# ------------------------------------------------------------------------------
MAX_WS_MESSAGE_SIZE=65536
MAX_TIMESTAMP_SKEW_SECONDS=300
WS_RATE_LIMIT_PER_MINUTE=1200
WS_AUTH_TIMEOUT_SECONDS=5.0

# ------------------------------------------------------------------------------
# Privacy & Data Retention Policy
# ------------------------------------------------------------------------------
# Automated retention threshold (days). Records older than this are purged by Celery.
DATA_RETENTION_DAYS=30
